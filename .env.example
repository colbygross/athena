# ==========================================
# ATHENA OS - Environment Configuration Template
# Copy this file to .env and configure as needed:
#   cp .env.example .env
# ==========================================

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Database & Storage (defaults to repository paths if unset)
DB_PATH=./backend/life_dashboard.db
WORKSPACE_DIR=.
VAULT_DIR=./obsidian_vault
INBOX_DIR=./obsidian_vault/Inbox
STORAGE_DIR=./storage

# Local Multi-Modal LLM Configuration (Ollama)
LLM_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi4-mini:latest
OLLAMA_VISION_MODEL=qwen3-vl:2b
OLLAMA_FINANCE_MODEL=qwen2.5-coder:3b

# Cloud AI Fallback (Optional - Gemini API)
GEMINI_API_KEY=

# Optional: Career Discovery Engine (Adzuna / RapidAPI)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
RAPIDAPI_KEY=

# Optional: Outbound Recruiter Outreach SMTP
OUTREACH_EMAIL=
OUTREACH_PASSWORD=
OUTREACH_SMTP_SERVER=
OUTREACH_SMTP_PORT=587

# Security (Optional token protection for endpoints)
API_KEY=
